# Copy to `.env` and fill in. `.env` is gitignored; this template is not.
#
# Nothing here has a working default. The app is built so that a missing secret
# disables the thing it protects rather than falling back to a known value:
# without SESSION_SECRET no session can be signed, so no login can succeed, and
# the admin endpoints answer 401 or 503 instead of ever answering 2xx. Leaving a
# variable blank is safe. Inventing a placeholder that looks real is not.
#
# The public deployment sets these in Render's environment settings. They are
# never written to a file in this repo.

# ---------------------------------------------------------------- operator login
# Only needed to reach /secure-model. The app runs fine without any of it; the
# public site does not use them.

# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Bootstraps the first operator account, after which the account lives in the
# database and these are ignored. Generate the hash without typing the password
# into your shell history:
#   python -c "import getpass,sys; sys.path.insert(0,'backend'); from auth import hash_password; print(hash_password(getpass.getpass()))"
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# Long random string for machine callers (the retrain/backtest workflows use it
# as the X-Admin-Key header). Generate the same way as SESSION_SECRET.
ADMIN_API_KEY=

# 1 in production so the session cookie is HTTPS-only. 0 for local http.
COOKIE_SECURE=0

# ---------------------------------------------------------------- password reset
# Optional. Without RESEND_API_KEY the reset flow is simply unavailable.
RESEND_API_KEY=
RESET_EMAIL_TO=
RESET_EMAIL_FROM=
# Base URL the emailed link points at, e.g. https://your-site.example
RESET_LINK_BASE=

# ---------------------------------------------------------------- storage
# Postgres URL for a real deployment. Left blank, the app uses SQLite under
# DATA_DIR, which is what docker compose and local runs do.
DATABASE_URL=
DATA_DIR=./dbdata
MODEL_DIR=./saved_models
SEED_DIR=./seed

# ---------------------------------------------------------------- behaviour
# Hours between background refreshes of the in-progress season.
REFRESH_INTERVAL_HOURS=6
# 1 exposes /docs and /redoc. Off by default: the schema lists every admin route.
# Turning it off removes the signpost, not the lock; require_admin holds either way.
ENABLE_DOCS=0

# Comma-separated origins allowed to call the API with credentials. Defaults to
# localhost:3000 and the deployed site. Never set this to "*": the CORS spec
# forbids pairing a wildcard with credentials, and it would let any site on the
# internet call this API with a logged-in operator's cookie attached.
ALLOWED_ORIGINS=http://localhost:3000
